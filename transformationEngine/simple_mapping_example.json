{
  "mappings": [
    {
      "target": "full_name",
      "source": "first_name,last_name",
      "transform": "trns: STRING[CONCAT(attr('first_name'), ' ', attr('last_name'))]"
    },
    {
      "target": "age_group",
      "source": "age",
      "transform": "trns: LOGICAL[IF(GT(attr('age'), 18), 'Adult', 'Minor')]"
    },
    {
      "target": "salary_category",
      "source": "salary",
      "transform": "trns: LOGICAL[IF(GT(attr('salary'), 60000), 'High', 'Low')]"
    },
    {
      "target": "name_upper",
      "source": "first_name",
      "transform": "trns: STRING[UPPER(attr('first_name'))]"
    },
    {
      "target": "age_doubled",
      "source": "age",
      "transform": "trns: MATH[MUL(attr('age'), 2)]"
    }
  ]
}