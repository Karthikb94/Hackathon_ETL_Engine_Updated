  "transformation_functions": {
    "description": "Supported transformation functions in the ETL Engine",
    "string_functions": [
      "UPPER(field_name) - Convert to uppercase",
      "LOWER(field_name) - Convert to lowercase", 
      "CONCAT(field1, 'separator', field2) - Concatenate fields",
      "TRIM(field_name) - Remove leading/trailing spaces",
      "DIRECT[ATTR(field_name)] - Direct field reference"
    ],
    "math_functions": [
      "ADD(field1, field2) - Addition",
      "SUB(field1, field2) - Subtraction",
      "MUL(field1, field2) - Multiplication",
      "DIV(field1, field2) - Division"
    ],
    "nested_field_access": [
      "personal_info.first_name - Access nested JSON fields",
      "compensation.salary - Access nested object properties",
      "DIRECT[ATTR(nested.field)] - Direct nested field access"
    ],
    "pass_through": [
      "'' - Empty string for direct field copying",
      "No trns field - Direct field mapping"
    ]
  },
