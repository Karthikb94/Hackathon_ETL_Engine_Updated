      "source_schema": {
        "role": "source",
        "fileType": "csv",
        "schemaId": "schm-csv-1001",
        "schemaName": "employee_csv_v1",
        "attributes": {
          "employee_id": {
            "dataType": "integer",
            "column_no": 1
          },
          "first_name": {
            "dataType": "string",
            "column_no": 2
          },
          "last_name": {
            "dataType": "string",
            "column_no": 3
          },
          "email": {
            "dataType": "string",
            "column_no": 4
          },
          "department": {
            "dataType": "string",
            "column_no": 5
          },
          "salary": {
            "dataType": "float",
            "column_no": 6
          }
        }
      },
      "target_schema": {
        "role": "target",
        "fileType": "json",
        "schemaId": "schm-json-2001",
        "schemaName": "employee_json_v1",
        "attributes": {}
      },
      "transformation_mapping": {
        "mappingId": "parquet-csv-to-json-001",
        "mappingName": "parquet_csv_to_json_transformation",
        "createdAt": "2025-09-14T23:35:00.000Z",
        "sourceSchemaId": "schm-csv-1001",
        "targetSchemaId": "schm-json-2001",
        "rules": [
          {
            "id": "pass_employee_id",
            "trns": "",
            "affected_source": ["employee_id"],
            "affected_target": "employee_id"
          },
          {
            "id": "full_name",
            "trns": "CONCAT(first_name, ' ', last_name)",
            "affected_source": ["first_name", "last_name"],
            "affected_target": "full_name"
          },
          {
            "id": "pass_email",
            "trns": "LOWER(email)",
            "affected_source": ["email"],
            "affected_target": "email"
          },
          {
            "id": "pass_department",
            "trns": "UPPER(department)",
            "affected_source": ["department"],
            "affected_target": "department"
          },
          {
            "id": "annual_salary",
            "trns": "MUL(salary, 12)",
            "affected_source": ["salary"],
            "affected_target": "annual_salary"
          }
        ]
      }
    },
